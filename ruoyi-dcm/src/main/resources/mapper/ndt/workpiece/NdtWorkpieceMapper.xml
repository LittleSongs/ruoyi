<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ndt.workpiece.mapper.NdtWorkpieceMapper">
    <resultMap id="Map" type="com.ruoyi.ndt.workpiece.domain.NdtWorkpiece">
        <id property="id" column="id"/><result property="taskId" column="task_id"/>
        <result property="taskName" column="task_name"/><result property="workpieceName" column="workpiece_name"/>
        <result property="sortNo" column="sort_no"/><result property="status" column="status"/>
        <result property="remark" column="remark"/><result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/><result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/><result property="delFlag" column="del_flag"/>
    </resultMap>
    <sql id="base">select w.*,t.task_name from ndt_workpiece w join ndt_inspection_task t on t.id=w.task_id and t.del_flag='0'</sql>
    <select id="selectList" resultMap="Map"><include refid="base"/><where>w.del_flag='0'
        <if test="taskId != null">and w.task_id=#{taskId}</if>
        <if test="workpieceName != null and workpieceName != ''">and w.workpiece_name like concat('%',#{workpieceName},'%')</if>
        <if test="status != null and status != ''">and w.status=#{status}</if>
        <if test="params.scopeType == 'ASSIGNED'">and exists(select 1 from ndt_task_user tu where tu.task_id=w.task_id and tu.user_id=#{params.scopeUserId} and tu.can_view='1')</if>
        <if test="params.scopeType == 'NONE'">and 1=0</if>
    </where>order by w.task_id,w.sort_no,w.id</select>
    <select id="selectByTaskId" resultMap="Map"><include refid="base"/> where w.task_id=#{taskId} and w.del_flag='0' order by w.sort_no,w.id</select>
    <select id="selectById" resultMap="Map"><include refid="base"/> where w.id=#{id} and w.del_flag='0'</select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">insert into ndt_workpiece(task_id,workpiece_name,sort_no,status,remark,create_by,create_time,update_by,update_time,del_flag)
        values(#{taskId},#{workpieceName},#{sortNo},#{status},#{remark},#{createBy},sysdate(),#{updateBy},sysdate(),'0')</insert>
    <update id="update">update ndt_workpiece set workpiece_name=#{workpieceName},sort_no=#{sortNo},status=#{status},remark=#{remark},update_by=#{updateBy},update_time=sysdate() where id=#{id} and del_flag='0'</update>
    <update id="softDeleteByIds">update ndt_workpiece set del_flag='2',update_time=sysdate() where id in <foreach collection="array" item="id" open="(" close=")" separator=",">#{id}</foreach></update>
</mapper>
