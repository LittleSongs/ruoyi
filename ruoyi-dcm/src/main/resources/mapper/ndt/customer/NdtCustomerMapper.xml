<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ndt.customer.mapper.NdtCustomerMapper">
    <resultMap id="CustomerMap" type="com.ruoyi.ndt.customer.domain.NdtCustomer">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="contactName" column="contact_name"/>
        <result property="contactPhone" column="contact_phone"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>
    <select id="selectList" resultMap="CustomerMap">
        select * from ndt_customer
        <where>
            del_flag='0'
            <if test="name != null and name != ''">and name like concat('%',#{name},'%')</if>
            <if test="contactName != null and contactName != ''">and contact_name like concat('%',#{contactName},'%')</if>
        </where>
        order by create_time desc,id desc
    </select>
    <select id="selectById" resultMap="CustomerMap">
        select * from ndt_customer where id=#{id} and del_flag='0'
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into ndt_customer(name,contact_name,contact_phone,remark,create_by,create_time,update_by,update_time,del_flag)
        values(#{name},#{contactName},#{contactPhone},#{remark},#{createBy},sysdate(),#{updateBy},sysdate(),'0')
    </insert>
    <update id="update">
        update ndt_customer set name=#{name},contact_name=#{contactName},contact_phone=#{contactPhone},
        remark=#{remark},update_by=#{updateBy},update_time=sysdate() where id=#{id} and del_flag='0'
    </update>
    <update id="softDeleteByIds">
        update ndt_customer set del_flag='2',update_time=sysdate() where id in
        <foreach collection="array" item="id" open="(" close=")" separator=",">#{id}</foreach>
    </update>
</mapper>
