<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ndt.series.mapper.NdtDicomSeriesMapper">
    <resultMap id="Map" type="com.ruoyi.ndt.series.domain.NdtDicomSeries">
        <id property="id" column="id"/><result property="studyId" column="study_id"/>
        <result property="workpieceId" column="workpiece_id"/><result property="positionId" column="position_id"/>
        <result property="seriesInstanceUid" column="series_instance_uid"/><result property="modality" column="modality"/>
        <result property="seriesNumber" column="series_number"/><result property="seriesDescription" column="series_description"/>
        <result property="orthancSeriesId" column="orthanc_series_id"/>
        <result property="createBy" column="create_by"/><result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/><result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>
    <select id="selectById" resultMap="Map">select * from ndt_dicom_series where id=#{id} and del_flag='0'</select>
    <select id="selectByStudyId" resultMap="Map">select * from ndt_dicom_series where study_id=#{studyId} and del_flag='0' order by create_time,id</select>
    <select id="selectBySeriesInstanceUid" resultMap="Map">select * from ndt_dicom_series where series_instance_uid=#{seriesInstanceUid} and del_flag='0' limit 1</select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">insert into ndt_dicom_series(study_id,workpiece_id,position_id,series_instance_uid,modality,series_number,series_description,orthanc_series_id,create_by,create_time,update_by,update_time,del_flag)
        values(#{studyId},#{workpieceId},#{positionId},#{seriesInstanceUid},#{modality},#{seriesNumber},#{seriesDescription},#{orthancSeriesId},#{createBy},sysdate(),#{updateBy},sysdate(),'0')</insert>
</mapper>
