<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ndt.task.mapper.NdtInspectionTaskMapper">
    <resultMap id="TaskMap" type="com.ruoyi.ndt.task.domain.NdtInspectionTask">
        <id property="id" column="id"/>
        <result property="customerId" column="customer_id"/>
        <result property="customerName" column="customer_name"/>
        <result property="taskName" column="task_name"/>
        <result property="taskNo" column="task_no"/>
        <result property="status" column="status"/>
        <result property="startTime" column="start_time"/>
        <result property="finishTime" column="finish_time"/>
        <result property="description" column="description"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>
    <sql id="baseSelect">
        select t.*,c.name customer_name from ndt_inspection_task t
        join ndt_customer c on c.id=t.customer_id and c.del_flag='0'
    </sql>
    <select id="selectNdtInspectionTaskList" resultMap="TaskMap">
        <include refid="baseSelect"/>
        <where>
            t.del_flag='0'
            <if test="taskNo != null and taskNo != ''">and t.task_no like concat('%',#{taskNo},'%')</if>
            <if test="taskName != null and taskName != ''">and t.task_name like concat('%',#{taskName},'%')</if>
            <if test="customerId != null">and t.customer_id=#{customerId}</if>
            <if test="status != null and status != ''">and t.status=#{status}</if>
            <if test="params.scopeType == 'CUSTOMER'">
                and exists(select 1 from ndt_inspection_task ct
                    join ndt_customer cc on cc.id=ct.customer_id and cc.del_flag='0'
                    where ct.id=t.id and ct.customer_id=#{params.scopeCustomerId} and ct.del_flag='0')
            </if>
            <if test="params.scopeType == 'ASSIGNED'">
                and exists(select 1 from ndt_task_user tu where tu.task_id=t.id
                    and tu.user_id=#{params.scopeUserId} and tu.can_view='1')
            </if>
            <if test="params.scopeType == 'NONE'">and 1=0</if>
        </where>
        order by t.create_time desc,t.id desc
    </select>
    <select id="selectNdtInspectionTaskById" resultMap="TaskMap">
        <include refid="baseSelect"/> where t.id=#{id} and t.del_flag='0'
    </select>
    <select id="selectNdtInspectionTaskByTaskNo" resultMap="TaskMap">
        <include refid="baseSelect"/> where t.task_no=#{taskNo} and t.del_flag='0' limit 1
    </select>
    <insert id="insertNdtInspectionTask" useGeneratedKeys="true" keyProperty="id">
        insert into ndt_inspection_task(customer_id,task_name,task_no,status,start_time,finish_time,description,
        create_by,create_time,update_by,update_time,del_flag)
        values(#{customerId},#{taskName},#{taskNo},#{status},#{startTime},#{finishTime},#{description},
        #{createBy},sysdate(),#{updateBy},sysdate(),'0')
    </insert>
    <update id="updateNdtInspectionTask">
        update ndt_inspection_task set customer_id=#{customerId},task_name=#{taskName},status=#{status},
        start_time=#{startTime},finish_time=#{finishTime},description=#{description},
        update_by=#{updateBy},update_time=sysdate() where id=#{id} and del_flag='0'
    </update>
    <update id="updateNdtInspectionTaskStatus">
        update ndt_inspection_task set status=#{status},update_by=#{updateBy},update_time=sysdate()
        where id=#{id} and del_flag='0'
    </update>
    <update id="softDeleteNdtInspectionTaskByIds">
        update ndt_inspection_task set del_flag='2',update_time=sysdate() where id in
        <foreach collection="array" item="id" open="(" close=")" separator=",">#{id}</foreach>
    </update>
</mapper>
