<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ndt.study.mapper.NdtInspectionStudyMapper">
    <resultMap id="Map" type="com.ruoyi.ndt.study.domain.NdtInspectionStudy">
        <id property="id" column="id"/><result property="workpieceId" column="workpiece_id"/>
        <result property="workpieceName" column="workpiece_name"/><result property="taskId" column="task_id"/>
        <result property="studyInstanceUid" column="study_instance_uid"/>
        <result property="inspectionMethodCode" column="inspection_method_code"/>
        <result property="studyNo" column="study_no"/><result property="studyDescription" column="study_description"/>
        <result property="studyDate" column="study_date"/><result property="studyTime" column="study_time"/>
        <result property="orthancStudyId" column="orthanc_study_id"/><result property="status" column="status"/>
        <result property="seriesCount" column="series_count"/><result property="objectCount" column="object_count"/>
        <result property="createBy" column="create_by"/><result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/><result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>
    <sql id="base">select s.*,w.task_id,w.workpiece_name,
        (select count(1) from ndt_dicom_series ds where ds.study_id=s.id and ds.del_flag='0') series_count,
        (select count(1) from ndt_dicom_object o join ndt_dicom_series ds on ds.id=o.series_id and ds.del_flag='0' where ds.study_id=s.id and o.del_flag='0') object_count
        from ndt_inspection_study s join ndt_workpiece w on w.id=s.workpiece_id and w.del_flag='0'</sql>
    <select id="selectList" resultMap="Map"><include refid="base"/><where>s.del_flag='0'
        <if test="workpieceId != null">and s.workpiece_id=#{workpieceId}</if>
        <if test="taskId != null">and w.task_id=#{taskId}</if>
        <if test="inspectionMethodCode != null and inspectionMethodCode != ''">and s.inspection_method_code=#{inspectionMethodCode}</if>
        <if test="studyInstanceUid != null and studyInstanceUid != ''">and s.study_instance_uid=#{studyInstanceUid}</if>
        <if test="params.scopeType == 'ASSIGNED'">and exists(select 1 from ndt_task_user tu where tu.task_id=w.task_id and tu.user_id=#{params.scopeUserId} and tu.can_view='1')</if>
        <if test="params.scopeType == 'NONE'">and 1=0</if>
    </where>order by s.create_time desc,s.id desc</select>
    <select id="selectByWorkpieceId" resultMap="Map"><include refid="base"/> where s.workpiece_id=#{workpieceId} and s.del_flag='0' order by s.create_time,s.id</select>
    <select id="selectById" resultMap="Map"><include refid="base"/> where s.id=#{id} and s.del_flag='0'</select>
    <select id="selectByStudyInstanceUid" resultMap="Map"><include refid="base"/> where s.study_instance_uid=#{studyInstanceUid} and s.del_flag='0' limit 1</select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">insert into ndt_inspection_study(workpiece_id,study_instance_uid,inspection_method_code,study_no,study_description,study_date,study_time,orthanc_study_id,status,create_by,create_time,update_by,update_time,del_flag)
        values(#{workpieceId},#{studyInstanceUid},#{inspectionMethodCode},#{studyNo},#{studyDescription},#{studyDate},#{studyTime},#{orthancStudyId},#{status},#{createBy},sysdate(),#{updateBy},sysdate(),'0')</insert>
</mapper>
