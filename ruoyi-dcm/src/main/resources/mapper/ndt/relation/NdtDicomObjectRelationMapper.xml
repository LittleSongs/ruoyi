<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ndt.relation.mapper.NdtDicomObjectRelationMapper">
    <resultMap id="Map" type="com.ruoyi.ndt.relation.domain.NdtDicomObjectRelation">
        <id property="id" column="id"/><result property="sourceObjectId" column="source_object_id"/>
        <result property="targetObjectId" column="target_object_id"/><result property="relationType" column="relation_type"/>
        <result property="remark" column="remark"/><result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
    </resultMap>
    <select id="selectByObjectId" resultMap="Map">select * from ndt_dicom_object_relation where source_object_id=#{objectId} or target_object_id=#{objectId} order by id</select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">insert into ndt_dicom_object_relation(source_object_id,target_object_id,relation_type,remark,create_by,create_time) values(#{sourceObjectId},#{targetObjectId},#{relationType},#{remark},#{createBy},sysdate())</insert>
    <delete id="deleteById">delete from ndt_dicom_object_relation where id=#{id}</delete>
</mapper>
