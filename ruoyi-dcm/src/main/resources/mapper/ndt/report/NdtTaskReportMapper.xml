<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ndt.report.mapper.NdtTaskReportMapper">
    <resultMap id="Map" type="com.ruoyi.ndt.report.domain.NdtTaskReport">
        <id property="id" column="id"/><result property="taskId" column="task_id"/>
        <result property="taskName" column="task_name"/><result property="reportName" column="report_name"/>
        <result property="version" column="version"/><result property="filePath" column="file_path"/>
        <result property="objectKey" column="object_key"/><result property="sha256" column="sha256"/>
        <result property="status" column="status"/><result property="generateBy" column="generate_by"/>
        <result property="generateName" column="generate_name"/><result property="generateTime" column="generate_time"/>
        <result property="createBy" column="create_by"/><result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/><result property="updateTime" column="update_time"/>
    </resultMap>
    <sql id="base">select r.*,t.task_name,u.nick_name generate_name from ndt_task_report r join ndt_inspection_task t on t.id=r.task_id and t.del_flag='0' left join sys_user u on u.user_id=r.generate_by</sql>
    <select id="selectList" resultMap="Map"><include refid="base"/><where>1=1
        <if test="taskId != null">and r.task_id=#{taskId}</if>
        <if test="status != null and status != ''">and r.status=#{status}</if>
        <if test="reportName != null and reportName != ''">and r.report_name like concat('%',#{reportName},'%')</if>
        <if test="params.scopeType == 'CUSTOMER'">and exists(select 1 from ndt_inspection_task ct
            join ndt_customer cc on cc.id=ct.customer_id and cc.del_flag='0'
            where ct.id=r.task_id and ct.customer_id=#{params.scopeCustomerId} and ct.del_flag='0')</if>
        <if test="params.scopeType == 'ASSIGNED'">and exists(select 1 from ndt_task_user tu where tu.task_id=r.task_id and tu.user_id=#{params.scopeUserId} and tu.can_view='1')</if>
        <if test="params.scopeType == 'NONE'">and 1=0</if>
    </where>order by r.generate_time desc,r.id desc</select>
    <select id="selectById" resultMap="Map"><include refid="base"/> where r.id=#{id}</select>
    <select id="selectMaxNumericVersion" resultType="Integer">select coalesce(max(cast(version as unsigned)),0) from ndt_task_report where task_id=#{taskId}</select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">insert into ndt_task_report(task_id,report_name,version,file_path,object_key,sha256,status,generate_by,generate_time,create_by,create_time,update_by,update_time) values(#{taskId},#{reportName},#{version},#{filePath},#{objectKey},#{sha256},#{status},#{generateBy},#{generateTime},#{createBy},sysdate(),#{updateBy},sysdate())</insert>
    <update id="updateStatus">update ndt_task_report set status=#{status},update_by=#{updateBy},update_time=sysdate() where id=#{id}</update>
    <delete id="deleteById">delete from ndt_task_report where id=#{id}</delete>
</mapper>
